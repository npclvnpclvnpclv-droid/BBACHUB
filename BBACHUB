
-- Lucky Block Spawner PRO
-- Mobile + PC
-- LocalScript ใน StarterPlayerScripts

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "LuckyBlockSpawnerUI"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- ปุ่มเปิด/ปิดหน้าต่าง
local toggle = Instance.new("TextButton")
toggle.Size = UDim2.fromOffset(110, 42)
toggle.Position = UDim2.new(0, 15, 0.35, 0)
toggle.Text = "เปิดเมนู"
toggle.TextScaled = true
toggle.Parent = gui

-- หน้าต่างหลัก
local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(270, 180)
frame.Position = UDim2.new(0.5, -135, 0.5, -90)
frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
frame.Visible = false
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

-- หัวหน้าต่าง
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -100, 0, 42)
title.Position = UDim2.fromOffset(10, 0)
title.BackgroundTransparency = 1
title.Text = "LUCKY BLOCK"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextScaled = true
title.Parent = frame

-- ปุ่มย่อ
local minimize = Instance.new("TextButton")
minimize.Size = UDim2.fromOffset(42, 36)
minimize.Position = UDim2.new(1, -88, 0, 3)
minimize.Text = "—"
minimize.TextScaled = true
minimize.Parent = frame

-- ปุ่มปิด
local close = Instance.new("TextButton")
close.Size = UDim2.fromOffset(42, 36)
close.Position = UDim2.new(1, -44, 0, 3)
close.Text = "X"
close.TextScaled = true
close.Parent = frame

-- ปุ่มเสก
local spawn = Instance.new("TextButton")
spawn.Size = UDim2.new(1, -24, 0, 55)
spawn.Position = UDim2.fromOffset(12, 65)
spawn.BackgroundColor3 = Color3.fromRGB(40, 170, 90)
spawn.TextColor3 = Color3.new(1, 1, 1)
spawn.Text = "เสก Lucky Block"
spawn.TextScaled = true
spawn.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 35)
status.Position = UDim2.fromOffset(10, 125)
status.BackgroundTransparency = 1
status.Text = "พร้อมใช้งาน"
status.TextColor3 = Color3.new(1, 1, 1)
status.TextScaled = true
status.Parent = frame

local minimized = false

toggle.Activated:Connect(function()
    frame.Visible = not frame.Visible
    toggle.Text = frame.Visible and "ซ่อนเมนู" or "เปิดเมนู"
end)

minimize.Activated:Connect(function()
    minimized = not minimized
    spawn.Visible = not minimized
    status.Visible = not minimized
    frame.Size = minimized
        and UDim2.fromOffset(270, 42)
        or UDim2.fromOffset(270, 180)
    minimize.Text = minimized and "+" or "—"
end)

close.Activated:Connect(function()
    frame.Visible = false
    toggle.Text = "เปิดเมนู"
end)

spawn.Activated:Connect(function()
    local remote = ReplicatedStorage:FindFirstChild("SpawnLuckyBlock")

    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer()
        status.Text = "ส่งคำขอแล้ว"
    else
        status.Text = "ไม่พบ SpawnLuckyBlock"
    end
end)
